mode: PAPER
initial_principal: 1000.0
# initial_balance: 1000.0  # 非推奨（initial_principal 未設定時のみ読み取り、DeprecationWarning）
currency: USD

principal:
  max_deposit_per_tx: 100000.0
  max_withdraw_per_tx: 100000.0
  require_confirm_on_withdraw: true

display:
  fx:
    enabled: true
    provider: exchangerate_host
    cache_ttl_sec: 900
    stale_after_sec: 1800
    fallback_rate: 150.0

market:
  id: BTC_5MIN_UPDOWN
  source: POLYMARKET
  binance_symbol: BTCUSDT

risk:
  max_trade_size_usd: 10.0
  daily_loss_limit_usd: 30.0
  emergency_stop_enabled: true
  consecutive_fail_limit: 3
  consecutive_fail_window_min: 15

websocket:
  polymarket_url: wss://ws-subscriptions-clob.polymarket.com/ws/
  binance_url: wss://stream.binance.com:9443/ws/btcusdt@trade
  reconnect_interval_sec: 5
  max_reconnect_attempts: 10
  stale_tick_sec: 30

nightly_review:
  enabled: true
  send_time: "04:00"
  timezone: Asia/Tokyo
  pause_trading_during_review: true

paths:
  db: data/yoruu.db
  strategy: config/strategy.json
  logs: logs/
  historical: data/historical/
  reports: reports/

ui:
  bind_host: 127.0.0.1
  port: 8765
  default_language: ja

logging:
  level: INFO
  rotate_mb: 50
  retain_days: 30

paper:
  spread_assumed: 0.02
  slippage_coeff: 0.0001
  slippage_max: 0.02
  latency_ms_mean: 80
  latency_ms_std: 20
